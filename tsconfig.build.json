{
  "compilerOptions": {
    "target": "ES2022",
    // Node's own resolution rather than a bundler's, because what this emits is
    // installed and imported rather than bundled. Under a bundler's rules a
    // relative import may leave its extension off, and `tsc` copies the specifier
    // into the output verbatim, so `dist/index.js` asked node for a directory and
    // node refused it: a published package only a bundler could load. The cost is
    // that every relative import in the sources below writes `.js` even though the
    // file beside it is `.ts`, which is what node will look for once it is emitted.
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "declaration": true,
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "skipLibCheck": true,
    "types": ["@webgpu/types"]
  },
  // What gets published, named rather than swept up. This config compiles
  // everything it can see and emits it, so a directory or a config file that
  // arrives beside the sources ends up either in the package or failing the build:
  // the tests did the second and the vitest config did it again. Listing the
  // library instead means a new file is published because somebody said so.
  "include": [
    "index.ts",
    "graph/**/*.ts",
    "gpu/**/*.ts",
    "resource/**/*.ts",
    "pipeline/**/*.ts",
    "submit/**/*.ts",
    "toy/**/*.ts",
    "scene/**/*.ts",
    "host/**/*.ts",
    "trace/**/*.ts",
    "shader-geometry.ts",
    "wgsl-binding.ts",
    "wgsl-layout.ts",
    "wgsl-references.ts"
  ],
  "exclude": ["dist", "node_modules"]
}
