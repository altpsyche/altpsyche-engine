{
  // Everything in the repository, which is wider than what publishes. The build
  // config names the library alone, so before this file existed the fixtures, the
  // tests and the gates were checked by nothing: vitest strips types without
  // reading them, and a gate is plain JavaScript. Code that arrives here from
  // somewhere it was checked would quietly stop being checked.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "strict": true,
    // The gates are `.mjs`, plain JavaScript node runs directly. Without these two
    // `tsc` reads them and checks nothing: a gate calling a library function whose
    // signature moved stayed green here and failed a browser gate an hour later,
    // four times, once costing a whole batch (item 76). `allowJs` lets them into
    // the program, `checkJs` checks them, and `gates/globals.d.ts` types the
    // library functions a gate hangs off `window` so those calls are checked too.
    "allowJs": true,
    "checkJs": true,
    "skipLibCheck": true,
    "types": ["@webgpu/types", "node"],
    // The door by its published name, which is how the tests and the fixtures
    // reach it, matching the alias vitest resolves them through.
    "paths": { "@altpsyche/engine": ["./index.ts"] },
    "baseUrl": "."
  },
  "include": ["index.ts", "graph/**/*.ts", "gpu/**/*.ts", "resource/**/*.ts", "pipeline/**/*.ts", "submit/**/*.ts", "toy/**/*.ts", "scene/**/*.ts", "host/**/*.ts", "trace/**/*.ts", "*.ts", "fixtures/**/*.ts", "tests/**/*.ts", "examples/**/*.ts", "gates/**/*.mjs", "gates/**/*.d.ts"],
  "exclude": ["dist", "node_modules"]
}
